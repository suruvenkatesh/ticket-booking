<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent: this pom.xml takes its settings from Spring Boot's pom.xml.
         Spring Boot pins versions for JUnit, AssertJ, Spring and the Maven plugins,
         so the dependencies below don't need their own <version> -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Coordinates: uniquely identify this project (like a package name for the whole build) -->
    <groupId>com.ticketbooking</groupId>
    <artifactId>booking-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <properties>
        <!-- The parent turns this into the compiler's Java version -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- scope "test": only on the classpath for src/test, never shipped with the app -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
